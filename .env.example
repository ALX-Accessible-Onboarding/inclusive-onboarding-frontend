# Inclusive Access Kit - Frontend Environment Configuration

# Live Backend API URL
API_BASE_URL=https://inclusive-onboarding-backend.onrender.com/api/v1

# Operation Mode: 'live' (real backend on Render) or 'mock' (in-memory demo)
KIT_MODE=live

# Auth token for API calls
API_TOKEN=demo-token

# Voice provider chain (server-side only: read by api/voice/speak.js).
# 'auto' (default): Edge TTS first, Gemini fallback when a key is set.
# 'edge': Edge TTS only (no key needed). 'gemini': Gemini only (key needed).
# VOICE_PROVIDER=auto

# Edge TTS Amharic voice. Only the two native Amharic voices are accepted.
# Default: am-ET-MekdesNeural (female). Male alternative: am-ET-AmehaNeural.
# EDGE_TTS_VOICE=am-ET-MekdesNeural

# Gemini TTS (server-side only: read by api/voice/speak.js, never in browser code)
# Get a key at https://aistudio.google.com/apikey
# Put the real key in .env (git-ignored) for `vercel dev`, or in the Vercel
# dashboard (Project > Settings > Environment Variables) for deployments.
# NEVER commit a real key to GitHub.
GEMINI_API_KEY=

# Optional overrides. Defaults: gemini-3.8-flash-lite-tts / Kore.
# Only allowlisted models are accepted by api/voice/speak.js.
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Kore
# GEMINI_TTS_VOICE also accepts an Extended Voice Library voice ID or a
# Voice design ID (voice_...). The prebuilt voices are cross-lingual and
# can sound American speaking Amharic; list Amharic library voices with
# `npm run voices` (uses the key from .env, never prints it) and paste the
# chosen id here exactly. Audition in the browser at
# https://aistudio.google.com/generate-speech
# Delivery steering sent with every Amharic request (speech_metadata
# style). Default: native Ethiopian Amharic accent, natural pronunciation,
# clear and calm, at a natural pace. Set to "none" to send no annotation.
# GEMINI_TTS_STYLE=Native Ethiopian Amharic accent, natural pronunciation, clear and calm, at a natural pace.
